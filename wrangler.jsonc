{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shoal-quick-web-join",
  "main": "src/join/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "JOIN_FLOWS", "class_name": "JoinFlow" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JoinFlow"] }],
  "vars": {
    "GITHUB_APP_ID": "",
    "GITHUB_APP_SLUG": "",
    "GITHUB_APP_CLIENT_ID": "",
    "JOIN_SERVICE_ORIGIN": "https://shoal-quick-web-join.YOUR-SUBDOMAIN.workers.dev",
    "JOIN_WEBSITE_RETURN_URL": "https://taco3064.github.io/shoal-app/join/",
  },
}
