---
import "../styles.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = "og-shoal.webp" } = Astro.props;
const navigation = [
  { href: `${import.meta.env.BASE_URL}#how-it-works`, label: "Understand Shoal" },
  { href: `${import.meta.env.BASE_URL}reviewers/`, label: "Explore Reviewers" },
  { href: `${import.meta.env.BASE_URL}join/`, label: "Become a Reviewer" },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}${image}`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#091b25" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}apple-touch-icon.png`}
    />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}favicon.png`}
      type="image/png"
    />
  </head>
  <body>
    <header class="site-header wrap">
      <a
        class="wordmark"
        href={import.meta.env.BASE_URL}
        aria-label="Shoal home"
      >
        <img
          class="brand-logo"
          src={`${import.meta.env.BASE_URL}shoal-logo.webp`}
          alt="Shoal"
          width="900"
          height="323"
        />
      </a>
      <nav class="desktop-navigation" aria-label="Main navigation">
        {navigation.map(({ href, label }) => <a class="text-link" href={href}>{label}</a>)}
      </nav>
      <button class="icon-control menu-trigger" aria-label="Open menu" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-haspopup="dialog" hidden>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </header>
    <dialog id="mobile-navigation" class="navigation-drawer" aria-labelledby="menu-title">
      <div class="drawer-heading">
        <h2 id="menu-title">Explore Shoal</h2>
        <form method="dialog"><button class="icon-control" aria-label="Close menu" autofocus><svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg></button></form>
      </div>
      <nav aria-label="Mobile navigation">
        {navigation.map(({ href, label }) => <a class="text-link" href={href}>{label}</a>)}
      </nav>
    </dialog>
    <slot />
    <footer class="footer">
      <div class="wrap footer-inner">
        <a class="wordmark" href={import.meta.env.BASE_URL}>
          <img
            class="brand-logo"
            src={`${import.meta.env.BASE_URL}shoal-logo.webp`}
            alt="Shoal home"
            width="900"
            height="323"
          />
        </a>
        <p>Review the work. Explain the Star.</p>
        <div class="footer-links">
          <a class="text-link source-link" href="https://github.com/taco3064/shoal-app" target="_blank" rel="noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-14-2 16" /></svg>Source</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('.menu-trigger');
  const drawer = document.querySelector<HTMLDialogElement>('#mobile-navigation');

  if (trigger && drawer) {
    trigger.hidden = false;
    document.documentElement.classList.add('navigation-enhanced');

    trigger.addEventListener('click', () => {
      drawer.showModal();
      trigger.setAttribute('aria-expanded', 'true');
    });

    drawer.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') {
        return;
      }

      const controls = Array.from(drawer.querySelectorAll<HTMLElement>('button, a[href]'));
      const first = controls[0];
      const last = controls.at(-1);

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });

    drawer.addEventListener('close', () => {
      trigger.setAttribute('aria-expanded', 'false');
      trigger.focus();
    });

    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) {
        const bounds = drawer.getBoundingClientRect();

        if (event.clientX < bounds.left || event.clientX > bounds.right
          || event.clientY < bounds.top || event.clientY > bounds.bottom) {
          drawer.close();
        }
      }
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => drawer.close());
    });

    window.matchMedia('(min-width: 801px)').addEventListener('change', (event) => {
      if (event.matches && drawer.open) {
        drawer.close();
      }
    });
  }
</script>
