---
import "../styles.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
}
const {
  title,
  description,
  image = "og-shoal.webp",
  imageAlt = "Shoal wordmark with a shark and a yellow Star",
} = Astro.props;
const navigation = [
  { href: `${import.meta.env.BASE_URL}how-it-works/`, label: "How Shoal works" },
  { href: `${import.meta.env.BASE_URL}reviewers/`, label: "Explore Reviewers" },
  { href: `${import.meta.env.BASE_URL}join/`, label: "Become a Reviewer" },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const pageUrl = canonical.href;
const breadcrumbItems = [{ name: 'Shoal', item: siteUrl }];

if (pageUrl !== siteUrl) {
  if (Astro.url.pathname.includes('/reviewers/') && !Astro.url.pathname.endsWith('/reviewers/')) {
    breadcrumbItems.push({ name: 'Reviewer Directory', item: `${siteUrl}reviewers/` });
  }

  breadcrumbItems.push({ name: title, item: pageUrl });
}

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Brand', '@id': `${siteUrl}#brand`, name: 'Shoal', url: siteUrl,
      logo: {
        '@type': 'ImageObject', url: `${siteUrl}shoal-logo.webp`,
        width: 1200, height: 403, caption: 'Shoal',
      },
    },
    {
      '@type': 'WebSite', '@id': `${siteUrl}#website`, name: 'Shoal', url: siteUrl,
      about: { '@id': `${siteUrl}#brand` }, inLanguage: 'en',
    },
    {
      '@type': 'WebPage', '@id': `${pageUrl}#page`, name: title, description,
      url: pageUrl, isPartOf: { '@id': `${siteUrl}#website` }, inLanguage: 'en',
      ...(breadcrumbItems.length > 1
        ? { breadcrumb: { '@id': `${pageUrl}#breadcrumbs` } } : {}),
    },
    ...(breadcrumbItems.length > 1 ? [{
      '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumbs`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem', position: index + 1, ...item,
      })),
    }] : []),
  ],
};
const serializedGraph = JSON.stringify(graph).replaceAll('<', '\\u003c').replaceAll('>', '\\u003e').replaceAll('&', '\\u0026');
const ogImage = new URL(`${import.meta.env.BASE_URL}${image}`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#091b25" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="uiJV6ksrGNcp_HmciZUGQLmPKQYO4Ka2XSXFRy1IS0g" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shoal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={serializedGraph} />
    <slot name="head" />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}apple-touch-icon.png`}
    />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}favicon.png`}
      type="image/png"
    />
  </head>
  <body>
    <header class="site-header wrap">
      <a
        class="wordmark"
        href={import.meta.env.BASE_URL}
        aria-label="Shoal home"
      >
        <img
          class="brand-logo"
          src={`${import.meta.env.BASE_URL}shoal-logo.webp`}
          alt="Shoal"
          width="1200"
          height="403"
        />
      </a>
      <nav class="desktop-navigation" aria-label="Main navigation">
        {navigation.map(({ href, label }) => <a class="text-link" href={href}>{label}</a>)}
      </nav>
      <button class="icon-control menu-trigger" aria-label="Open menu" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-haspopup="dialog" hidden>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </header>
    <dialog id="mobile-navigation" class="navigation-drawer" aria-labelledby="menu-title">
      <div class="drawer-heading">
        <h2 id="menu-title">Explore Shoal</h2>
        <form method="dialog"><button class="icon-control" aria-label="Close menu" autofocus><svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg></button></form>
      </div>
      <nav aria-label="Mobile navigation">
        {navigation.map(({ href, label }) => <a class="text-link" href={href}>{label}</a>)}
      </nav>
    </dialog>
    <slot />
    <footer class="footer">
      <div class="wrap footer-inner">
        <a class="wordmark" href={import.meta.env.BASE_URL}>
          <img
            class="brand-logo"
            src={`${import.meta.env.BASE_URL}shoal-logo.webp`}
            alt="Shoal home"
            width="1200"
            height="403"
          />
        </a>
        <p>Review the work. Explain the Star.</p>
        <a class="text-link" href={`${import.meta.env.BASE_URL}llms.txt`}>Public reading guide</a>
        <div class="footer-links">
          <a class="text-link source-link" href="https://github.com/taco3064/shoal-app" target="_blank" rel="noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-14-2 16" /></svg>Source</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('.menu-trigger');
  const drawer = document.querySelector<HTMLDialogElement>('#mobile-navigation');

  if (trigger && drawer) {
    trigger.hidden = false;
    document.documentElement.classList.add('navigation-enhanced');

    let closingTimer: ReturnType<typeof setTimeout> | undefined;

    const closeDrawer = () => {
      if (!drawer.open || drawer.classList.contains('is-closing')) {
        return;
      }

      drawer.classList.remove('is-visible');
      drawer.classList.add('is-closing');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      closingTimer = setTimeout(() => drawer.close(), reduced ? 0 : 260);
    };

    drawer.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeDrawer();
    });

    drawer.querySelector('form')?.addEventListener('submit', (event) => {
      event.preventDefault();
      closeDrawer();
    });

    trigger.addEventListener('click', () => {
      clearTimeout(closingTimer);
      drawer.classList.remove('is-closing', 'is-visible');
      drawer.showModal();
      // Commit the offscreen state before beginning the visible transition.
      drawer.getBoundingClientRect();
      drawer.classList.add('is-visible');
      trigger.setAttribute('aria-expanded', 'true');
    });

    drawer.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') {
        return;
      }

      const controls = Array.from(drawer.querySelectorAll<HTMLElement>('button, a[href]'));
      const first = controls[0];
      const last = controls.at(-1);

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });

    drawer.addEventListener('close', () => {
      clearTimeout(closingTimer);
      drawer.classList.remove('is-visible', 'is-closing');
      trigger.setAttribute('aria-expanded', 'false');

      const focusTarget = trigger.getClientRects().length
        ? trigger
        : document.querySelector<HTMLElement>('.desktop-navigation a');

      focusTarget?.focus();
    });

    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) {
        const bounds = drawer.getBoundingClientRect();

        if (event.clientX < bounds.left || event.clientX > bounds.right
          || event.clientY < bounds.top || event.clientY > bounds.bottom) {
          closeDrawer();
        }
      }
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeDrawer());
    });

    window.matchMedia('(min-width: 801px)').addEventListener('change', (event) => {
      if (event.matches && drawer.open) {
        closeDrawer();
      }
    });
  }
</script>


<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const groups = document.querySelectorAll<HTMLElement>('[data-count-group]');
  const running = new Set<Animation>();

  const animateGroup = (group: HTMLElement) => {
    if (group.dataset.countPlayed) {
      return;
    }

    group.dataset.countPlayed = 'true';

    if (reducedMotion.matches) {
      return;
    }

    group.querySelectorAll<HTMLElement>('[data-rolling-count]').forEach((metric) => {
      const value = metric.textContent?.trim() ?? '';

      if (!/^\d+$/.test(value)) {
        return;
      }

      const accessibleValue = document.createElement('span');

      accessibleValue.className = 'sr-only';
      accessibleValue.textContent = value;
      const visual = document.createElement('span');

      visual.className = 'rolling-number';
      visual.setAttribute('aria-hidden', 'true');
      const animations: Animation[] = [];

      for (const digit of value) {
        const column = document.createElement('span');

        column.className = 'rolling-digit';
        const strip = document.createElement('span');

        strip.className = 'rolling-strip';
        const target = 10 + Number(digit);

        for (let position = 0; position <= target; position++) {
          const item = document.createElement('span');

          item.textContent = String(position % 10);
          strip.append(item);
        }

        column.append(strip);
        visual.append(column);
      }

      metric.replaceChildren(accessibleValue, visual);

      visual.querySelectorAll<HTMLElement>('.rolling-strip').forEach((strip, index) => {
        const offset = (10 + Number(value[index])) * 1.15;

        const animation = strip.animate([
          { transform: 'translateY(0)' },
          { transform: `translateY(-${offset}em)` },
        ], { duration: 900, easing: 'cubic-bezier(.2,.65,.3,1)', fill: 'forwards' });

        running.add(animation);
        animations.push(animation);
      });

      const finish = () => {
        metric.textContent = value;
        animations.forEach((animation) => running.delete(animation));
      };

      const completed = animations.map((animation) =>
        animation.finished.catch(() => undefined),
      );

      Promise.all(completed).then(finish);
    });
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        animateGroup(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  groups.forEach((group) => observer.observe(group));

  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) {
      running.forEach((animation) => animation.finish());
    }
  });
</script>
