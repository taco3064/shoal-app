---
import BaseLayout from "../layouts/BaseLayout.astro";
import SetupPrompt from "~app/guide/components/SetupPrompt";

const title = "Join Shoal — Root owner or direct fork";
const description =
  "Choose the Network Root owner path or four direct-fork setup stages, then write your own Review Policy.";
---

<BaseLayout title={title} description={description}>
  <main class="wrap guide-page">
    <header class="join-intro">
      <p class="section-kicker">BECOME A REVIEWER</p>
      <h1>Join Shoal</h1>
      <p>
        The Network Root owner uses the Root as their Reviewer Node. Everyone
        else directly forks it. Each Reviewer defines their own standard.
      </p>
      <p class="join-reassurance">
        Choose your path · no website account · no approval form
      </p>
    </header>

    <nav class="join-paths" aria-label="Choose a Reviewer setup path">
      <a href="#root-owner">I own the Network Root →</a>
      <a href="#direct-fork">I need to fork it →</a>
    </nav>

    <section
      id="root-owner"
      class="root-owner-path"
      aria-labelledby="root-owner-title"
    >
      <p class="section-kicker">NETWORK ROOT OWNER</p>
      <h2 id="root-owner-title">Use your Network Root as your Reviewer Node</h2>
      <p>
        If you own{" "}
        <a href="https://github.com/taco3064/shoal-station">
          taco3064/shoal-station
        </a>
        , you already have the Root-owner Reviewer Node. Do not fork it or run
        <code>gh shoal init</code> on it.
      </p>
      <div class="setup-options">
        <div class="setup-option">
          <h3>Set up locally</h3>
          <ol>
            <li>
              Clone or use your existing <code>taco3064/shoal-station</code>{" "}
              checkout.
            </li>
            <li>
              Install <a href="https://cli.github.com/">GitHub CLI ↗</a> and
              verify <code>gh auth status</code> as the Root owner.
            </li>
            <li>
              Install the official extension:{" "}
              <code>gh extension install taco3064/gh-shoal</code>.
            </li>
            <li>
              Personally write your Review Policy in the Root{" "}
              <code>README.md</code>, then commit and push it.
            </li>
          </ol>
        </div>
        <div class="setup-option">
          <h3>Ask a local coding agent</h3>
          <p>
            The agent can prepare your local tools, then returns the Policy
            decision to you.
          </p>
          <details class="prompt-details">
            <summary>Show Root-owner setup prompt</summary>
            <SetupPrompt path="root" client:load />
          </details>
        </div>
      </div>
      <p class="step-note">
        Root repository maintenance keeps Issues enabled and the canonical
        Review Request form and Summary Workflow valid. The Root's
        <code>README.md</code> is both your Review Policy and the initial Policy
        template inherited by new direct forks. Eligible Root owners appear
        after the next complete published Network Scan.
      </p>
    </section>

    <div id="direct-fork" class="journey" data-journey>
      <h2>Joining with a direct fork</h2>
      <nav class="journey-progress" aria-label="Setup stages">
        <a href="#join-fork" data-step-to="0">
          <span>01</span> Fork
        </a>
        <a href="#join-actions" data-step-to="1">
          <span>02</span> Actions
        </a>
        <a href="#join-setup" data-step-to="2">
          <span>03</span> Setup
        </a>
        <a href="#join-policy" data-step-to="3">
          <span>04</span> Policy
        </a>
      </nav>

      <section
        id="join-fork"
        class="journey-step"
        data-journey-step
        aria-labelledby="join-fork-title"
      >
        <p class="section-kicker">01 / 04 · YOUR NETWORK IDENTITY</p>
        <h2 id="join-fork-title">Directly fork the Network Root</h2>
        <p>
          Your personal account must directly fork the canonical Network Root. A
          fork of another Reviewer Node does not qualify.
        </p>
        <a
          class="button primary"
          href="https://github.com/taco3064/shoal-station/fork"
        >
          Fork shoal-station ↗
        </a>
        <div class="journey-step-actions">
          <a href="#join-actions" data-step-to="1">
            Next: enable Actions →
          </a>
        </div>
      </section>

      <section
        id="join-actions"
        class="journey-step"
        data-journey-step
        aria-labelledby="join-actions-title"
      >
        <p class="section-kicker">02 / 04 · YOU COMPLETE THIS IN GITHUB</p>
        <h2 id="join-actions-title">Confirm GitHub Actions</h2>
        <p>
          Open <strong>your new fork’s Actions page</strong> and personally
          complete GitHub’s manual enable / confirmation. Do this before{" "}
          <code>gh shoal init</code>.
        </p>
        <p class="step-note">
          Init cannot replace this UI step. Repository-level Actions permissions
          or an active workflow do not prove you completed it.
        </p>
        <div class="journey-step-actions">
          <a href="#join-fork" data-step-to="0">
            ← Back
          </a>
          <a href="#join-setup" data-step-to="2">
            Next: set up station →
          </a>
        </div>
      </section>

      <section
        id="join-setup"
        class="journey-step"
        data-journey-step
        aria-labelledby="join-setup-title"
      >
        <p class="section-kicker">
          03 / 04 · CHOOSE MANUAL OR AI-ASSISTED SETUP
        </p>
        <h2 id="join-setup-title">Set up your station</h2>
        <div class="setup-options">
          <div class="setup-option">
            <h3>Do it manually</h3>
            <ol>
              <li>
                Clone your fork:{" "}
                <code>
                  git clone
                  https://github.com/&lt;your-username&gt;/shoal-station.git
                </code>
                , then enter the folder.
              </li>
              <li>
                Install the <a href="https://cli.github.com/">GitHub CLI ↗</a>{" "}
                and confirm <code>gh auth status</code> works as the Reviewer
                Node owner.
              </li>
              <li>
                Install the official extension:{" "}
                <code>gh extension install taco3064/gh-shoal</code>.
              </li>
              <li>
                In a clean checkout, run <code>gh shoal init</code>.
              </li>
            </ol>
          </div>
          <div class="setup-option">
            <h3>Ask a local coding agent</h3>
            <p>
              Already completed stages 1 and 2? Copy one short prompt. The agent
              handles only the mechanical steps and stops before your Policy.
            </p>
            <details class="prompt-details">
              <summary>Show copyable setup prompt</summary>
              <SetupPrompt client:load />
            </details>
          </div>
        </div>
        <p class="step-note">
          Verify the managed Issue Form and Summary Workflow are canonical,
          <code>.github/workflows/reviewer-summary.yml</code> is active, and
          Issues are enabled. Init may repair that workflow and enable Issues;
          it cannot alter repository-level Actions policy or enable unrelated
          workflows.
        </p>
        <p class="step-note">
          This setup agent is separate from the agent later selected for{" "}
          <code>gh shoal review --agent &lt;agent&gt;</code>.
        </p>
        <div class="journey-step-actions">
          <a href="#join-actions" data-step-to="1">
            ← Back
          </a>
          <a href="#join-policy" data-step-to="3">
            Next: write your Policy →
          </a>
        </div>
      </section>

      <section
        id="join-policy"
        class="journey-step"
        data-journey-step
        aria-labelledby="join-policy-title"
      >
        <p class="section-kicker">04 / 04 · YOUR DECISION</p>
        <h2 id="join-policy-title">Write your Review Policy</h2>
        <p>
          <strong>You</strong> define the review standard in{" "}
          <code>README.md</code>. The setup agent and <code>gh shoal init</code>{" "}
          must leave that choice to you. Commit and push your Policy.
        </p>
        <p class="step-note">
          Directory eligibility requires Issues enabled, a supported canonical
          Review Request form, and an allowed Summary Workflow digest. Your
          entry appears after the next successful complete Network Scan and
          publication; the fork alone does not make you appear immediately.
        </p>
        <a
          class="button secondary"
          href={`${import.meta.env.BASE_URL}reviewers/`}
        >
          Explore the Reviewer Directory →
        </a>
        <div class="journey-step-actions">
          <a href="#join-setup" data-step-to="2">
            ← Back
          </a>
          <a href="#join-fork" data-step-to="0">
            Start again ↺
          </a>
        </div>
      </section>
    </div>

    <details class="join-reference">
      <summary>How Policy, trust, and Automated Review work</summary>
      <div>
        <p>
          <code>README.md</code> is your customizable Review Policy.{" "}
          <code>.github/ISSUE_TEMPLATE/review-request.yml</code> and{" "}
          <code>.github/workflows/reviewer-summary.yml</code> are Shoal-managed.
          Even whitespace or comment changes alter the Summary Workflow’s exact
          digest; a Summary from a workflow outside the allowed canonical digest
          set is rejected. Direct-fork owners run <code>gh shoal init</code> to
          repair managed-file drift; the Network Root uses its own canonical
          repository maintenance path. A fresh fork’s Actions UI confirmation
          remains yours to complete.
        </p>
        <p>
          Official Automated Review runs through your local{" "}
          <code>gh shoal</code> extension and an explicitly selected local AI
          agent: <code>claude</code>, <code>codex</code>, <code>gemini</code>,{" "}
          <code>opencode</code>, <code>cursor</code>, <code>grok</code>,{" "}
          <code>qwen</code>, or <code>kimi</code>. The extension owns GitHub
          mutations and Protocol handling. Shoal does not host or silently
          choose an agent. Manual Review is valid when formal Review / Re-review
          result comments use the recognized Protocol format. Invalid formal
          result comments are observable maintenance facts, not reputation
          scores.
        </p>
      </div>
    </details>
  </main>
</BaseLayout>

<script>
  const journey = document.querySelector<HTMLElement>("[data-journey]");
  const steps = Array.from(
    journey?.querySelectorAll<HTMLElement>("[data-journey-step]") ?? [],
  );
  const controls = Array.from(
    journey?.querySelectorAll<HTMLAnchorElement>("[data-step-to]") ?? [],
  );

  if (journey && steps.length) {
    journey.classList.add("is-enhanced");

    const show = (index: number, scroll = false) => {
      steps.forEach((step, position) => {
        step.hidden = position !== index;
      });
      controls.forEach((control) => {
        if (control.closest(".journey-progress")) {
          if (Number(control.dataset.stepTo) === index)
            control.setAttribute("aria-current", "step");
          else control.removeAttribute("aria-current");
        }
      });

      if (scroll) {
        const behavior = window.matchMedia("(prefers-reduced-motion: reduce)")
          .matches
          ? "auto"
          : "smooth";
        journey.scrollIntoView({ behavior, block: "start" });
      }
    };

    controls.forEach((control) =>
      control.addEventListener("click", (event) => {
        event.preventDefault();
        show(Number(control.dataset.stepTo), true);
      }),
    );

    const initial = steps.findIndex(
      (step) => `#${step.id}` === window.location.hash,
    );
    show(initial < 0 ? 0 : initial);
  }
</script>
