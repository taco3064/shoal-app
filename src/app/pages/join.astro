---
import BaseLayout from "../layouts/BaseLayout.astro";
import SetupPrompt from "~app/guide/components/SetupPrompt";

const title = "Join Shoal — Fork the Network Root";
const description =
  "Directly fork the Network Root, complete four setup stages, and write your own Review Policy.";
---

<BaseLayout title={title} description={description}>
  <main class="wrap guide-page join-page">
    <header class="join-intro">
      <p class="section-kicker">BECOME A REVIEWER</p>
      <h1>Join Shoal</h1>
      <p>
        Shoal is a public review network where repository owners request
        evaluation from independent Reviewers, and passing reviews can make
        real GitHub Stars explainable.
      </p>
      <p>
        Your station. Your Review Policy. Directly fork the Network Root to
        join.
      </p>
      <p class="join-reassurance">
        No website account · No approval form · Your standard
      </p>
    </header>

    <section class="reviewer-lifecycle" aria-labelledby="lifecycle-title">
      <div>
        <p class="section-kicker">BEFORE SETUP</p>
        <h2 id="lifecycle-title">What becoming a Reviewer means</h2>
        <p>
          You publish your own Review Policy, receive public Review Requests,
          decide when to review, and record outcomes that can make your GitHub
          Stars explainable.
        </p>
      </div>
      <ol class="lifecycle-steps">
        <li>
          <strong>Own your Policy</strong>
          <span>Define your standard in README.md.</span>
        </li>
        <li>
          <strong>Receive Review Requests</strong>
          <span>Repository owners ask for evaluation, not for a Star.</span>
        </li>
        <li>
          <strong>Review manually or with gh shoal</strong>
          <span>You choose when to review and which local agent to authorize.</span>
        </li>
        <li>
          <strong>Back PASS with evidence</strong>
          <span>A valid PASS may turn your real Star into a public endorsement.</span>
        </li>
      </ol>
    </section>

    <div class="join-section-heading">
      <p class="section-kicker">START HERE</p>
      <h2>Fork the Network Root</h2>
    </div>
    <section id="direct-fork" class="journey" data-journey aria-label="Your station in four steps">
      <section
        id="join-fork"
        class="journey-step"
        data-journey-step
        aria-labelledby="join-fork-title"
      >
        <p class="section-kicker">01 / 04 · YOUR NETWORK IDENTITY</p>
        <h2 id="join-fork-title">Directly fork the Network Root</h2>
        <p>
          Your personal account must directly fork the canonical Network Root. A
          fork of another Reviewer Node does not qualify.
        </p>
        <a
          class="button primary"
          href="https://github.com/taco3064/shoal-station/fork"
          target="_blank"
          rel="noopener noreferrer"
        >
          Fork shoal-station
        </a>
        <div class="journey-step-actions">
          <a class="text-link" href="#join-actions" data-step-to="1" data-step-forward>
            Next: enable Actions →
          </a>
        </div>
      </section>

      <section
        id="join-actions"
        class="journey-step"
        data-journey-step
        aria-labelledby="join-actions-title"
      >
        <p class="section-kicker">02 / 04 · YOU COMPLETE THIS IN GITHUB</p>
        <h2 id="join-actions-title">Confirm GitHub Actions</h2>
        <p>
          Open <strong>your new fork’s Actions page</strong> and personally
          complete GitHub’s manual enable / confirmation. Do this before{" "}
          <code>gh shoal init</code>.
        </p>
        <p class="step-note">
          Init cannot replace this UI step. Repository-level Actions permissions
          or an active workflow do not prove you completed it.
        </p>
        <div class="journey-step-actions">
          <a class="text-link" href="#join-fork" data-step-to="0">
            ← Back
          </a>
          <a class="text-link" href="#join-setup" data-step-to="2" data-step-forward>
            Next: set up station →
          </a>
        </div>
      </section>

      <section
        id="join-setup"
        class="journey-step"
        data-journey-step
        aria-labelledby="join-setup-title"
      >
        <p class="section-kicker">
          03 / 04 · CHOOSE MANUAL OR AI-ASSISTED SETUP
        </p>
        <h2 id="join-setup-title">Set up your station</h2>
        <div class="setup-options">
          <details class="setup-option">
            <summary>
              <span>Manual setup</span>
              <small>Commands and verification</small>
            </summary>
            <ol>
              <li>
                Clone your fork using its GitHub URL, then enter the clean
                checkout.
              </li>
              <li>
                Install the <a class="text-link" href="https://cli.github.com/" target="_blank" rel="noopener noreferrer">GitHub CLI</a>{" "}
                and confirm <code>gh auth status</code> works as the Reviewer
                Node owner.
              </li>
              <li>
                Install the official extension:{" "}
                <code>gh extension install taco3064/gh-shoal</code>.
              </li>
              <li>
                In a clean checkout, run <code>gh shoal init</code>.
              </li>
            </ol>
          </details>
          <details class="setup-option">
            <summary>
              <span>Use a local coding agent</span>
              <small>One copyable prompt</small>
            </summary>
            <p>
              Already completed stages 1 and 2? Copy one short prompt. The agent
              handles only the mechanical steps and stops before your Policy.
            </p>
            <SetupPrompt client:load />
          </details>
        </div>
        <p class="step-note">
          Verify the managed Issue Form and Summary Workflow are canonical,
          <code>.github/workflows/reviewer-summary.yml</code> is active, and
          Issues are enabled. Init may repair that workflow and enable Issues;
          it cannot alter repository-level Actions policy or enable unrelated
          workflows.
        </p>
        <p class="step-note">
          This setup agent is separate from the agent later selected for{" "}
          <code>gh shoal review --agent &lt;agent&gt;</code>.
        </p>
        <div class="journey-step-actions">
          <a class="text-link" href="#join-actions" data-step-to="1">
            ← Back
          </a>
          <a class="text-link" href="#join-policy" data-step-to="3" data-step-forward>
            Next: write your Policy →
          </a>
        </div>
      </section>

      <section
        id="join-policy"
        class="journey-step"
        data-journey-step
        aria-labelledby="join-policy-title"
      >
        <p class="section-kicker">04 / 04 · YOUR DECISION</p>
        <h2 id="join-policy-title">Write your Review Policy</h2>
        <p>
          <strong>You</strong> define the review standard in{" "}
          <code>README.md</code>. The setup agent and <code>gh shoal init</code>{" "}
          must leave that choice to you. Commit and push your Policy.
        </p>
        <p class="step-note">
          Directory eligibility requires Issues enabled, a supported canonical
          Review Request form, and an allowed Summary Workflow digest. Your
          entry appears after the next successful complete Network Scan and
          publication; the fork alone does not make you appear immediately.
        </p>
        <a
          class="text-link"
          href={`${import.meta.env.BASE_URL}reviewers/`}
        >
          Explore the Reviewer Directory
        </a>
        <div class="journey-step-actions">
          <a class="text-link" href="#join-setup" data-step-to="2">
            ← Back
          </a>
          <a class="text-link" href="#join-fork" data-step-to="0">
            Start again
          </a>
        </div>
      </section>
    </section>

    <section class="join-reference" aria-labelledby="trust-title">
      <h2 id="trust-title">How Policy, trust, and Automated Review work</h2>
      <div>
        <section>
          <h3>Your Review Policy</h3>
          <p>You define your own standard in <code>README.md</code>. Setup leaves Policy authorship to you. Manual Review is valid when formal Review / Re-review results follow the recognized Protocol format.</p>
        </section>
        <section>
          <h3>Shoal-managed station surfaces</h3>
          <p><code>.github/ISSUE_TEMPLATE/review-request.yml</code> and <code>.github/workflows/reviewer-summary.yml</code> are Shoal-managed. Even whitespace or comments change the workflow’s exact digest; a Summary outside the allowed canonical digest set is rejected. Run <code>gh shoal init</code> to repair managed-file drift. A fresh fork’s Actions confirmation remains yours to complete.</p>
        </section>
        <section>
          <h3>Automated Review stays local</h3>
          <p>Run <code>gh shoal</code> with an explicitly selected local agent: <code>claude</code>, <code>codex</code>, <code>gemini</code>, <code>opencode</code>, <code>cursor</code>, <code>grok</code>, <code>qwen</code>, or <code>kimi</code>. The extension owns GitHub mutations and Protocol handling. Shoal does not host or silently choose an agent. Invalid formal result comments are maintenance facts, not reputation scores.</p>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const journey = document.querySelector<HTMLElement>('[data-journey]');

  const steps = Array.from(
    journey?.querySelectorAll<HTMLElement>('[data-journey-step]') ?? [],
  );

  const controls = Array.from(
    journey?.querySelectorAll<HTMLAnchorElement>('[data-step-to]') ?? [],
  );

  if (journey && steps.length) {
    journey.classList.add('is-enhanced');

    const show = (index: number, scroll = false) => {
      steps.forEach((step, position) => {
        step.hidden = position !== index;
      });

      if (scroll) {
        const heading = steps[index]?.querySelector<HTMLElement>('h2');

        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)')
          .matches
          ? 'auto'
          : 'smooth';

        heading?.setAttribute('tabindex', '-1');
        heading?.focus({ preventScroll: true });
        steps[index]?.scrollIntoView({ behavior, block: 'start' });
      }
    };

    controls.forEach((control) =>
      control.addEventListener('click', (event) => {
        event.preventDefault();
        history.pushState(null, '', control.hash);
        show(Number(control.dataset.stepTo), true);
      }),
    );

    const restore = () => {
      const index = steps.findIndex(
        (step) => `#${step.id}` === window.location.hash,
      );

      if (index >= 0) {
        show(index);
      } else if (!window.location.hash || window.location.hash === '#direct-fork') {
        show(0);
      }
    };

    show(0);
    window.addEventListener('popstate', restore);
    window.addEventListener('hashchange', restore);
    restore();
  }
</script>
