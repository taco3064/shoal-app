---
import BaseLayout from "../layouts/BaseLayout.astro";
import Guide from "~app/guide";
import { publishedProjection } from "~app/guide/services/projection_source";

const projection = await publishedProjection();

const title = "Shoal — Make a GitHub Star explainable";
const description =
  "A public review network where GitHub Stars carry a policy, a repository version, and a reason you can verify.";
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Shoal",
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  description,
};
---

<BaseLayout title={title} description={description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(website).replace(/</g, "\\u003c")}
  />
  <Guide reviewerCount={projection.reviewers.length} />
</BaseLayout>
