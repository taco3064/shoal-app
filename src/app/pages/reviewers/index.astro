---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewerDirectory from "~app/guide/components/ReviewerDirectory";
import { publishedProjection } from "~app/guide/services/projection_source";

const projection = await publishedProjection();
const isLocalSnapshot =
  import.meta.env.DEV && !process.env.SHOAL_PROJECTION_FILE;
const title = "Reviewer Directory — Shoal";
const description =
  "Explore the current eligible Shoal Reviewers and their public review context.";
---

<BaseLayout title={title} description={description}>
  <main class="wrap directory-page">
    <p class="section-kicker">PUBLIC NETWORK PROJECTION</p>
    <h1>Reviewer Directory</h1>
    <p>
      Eligible direct forks of the Network Root. Search covers this published
      snapshot only; joined dates mark fork creation, not setup completion.
    </p>
    <p>
      Snapshot generated:{" "}
      <time datetime={projection.generatedAt}>{projection.generatedAt}</time>
    </p>
    {isLocalSnapshot && (
      <aside class="local-preview-note" role="status">
        <strong>Local preview: recorded Network Scan snapshot.</strong>
        <p>
          This preview uses the validated snapshot dated above. Search only
          checks eligible Reviewers in that snapshot; it does not look up GitHub
          users live. For newer data, provide a complete scan output through{" "}
          <code>SHOAL_PROJECTION_FILE</code>.
        </p>
      </aside>
    )}
    <ReviewerDirectory reviewers={projection.reviewers} client:load />
  </main>
</BaseLayout>
