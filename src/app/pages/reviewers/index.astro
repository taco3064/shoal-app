---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewerDirectory from "~app/guide/components/ReviewerDirectory";
import { publishedProjection } from "~app/guide/services/projection_source";

const projection = await publishedProjection();
const isLocalSnapshot =
  import.meta.env.DEV && !process.env.SHOAL_PROJECTION_FILE;
const title = "Reviewer Directory — Shoal";
const description =
  "Explore the current eligible Shoal Reviewers and their public review context.";
---

<BaseLayout title={title} description={description}>
  <main class="wrap directory-page">
    <header class="directory-hero">
      <div>
        <p class="section-kicker">PUBLIC REVIEW NETWORK</p>
        <h1>Reviewer Directory</h1>
        <p>
          Discover people participating in Shoal, inspect how they review, and
          reach the public surface where you can request a review.
        </p>
      </div>
      <div class="directory-snapshot">
        <strong>{projection.reviewers.length}</strong>
        <span>eligible Reviewers</span>
        <small>
          Scanned{" "}
          <time datetime={projection.generatedAt}>
            {projection.generatedAt}
          </time>
        </small>
      </div>
    </header>
    <section
      class="orientation-grid directory-orientation"
      aria-label="What you can do in the Reviewer Directory"
    >
      <article>
        <p class="section-kicker">WHAT IS A REVIEWER?</p>
        <h2>A person-controlled Reviewer Node</h2>
        <p>
          Each listed Reviewer owns a public Review Policy and decides how to
          evaluate repositories. Shoal does not centrally rank or score them.
        </p>
      </article>
      <article>
        <p class="section-kicker">WHY BROWSE?</p>
        <h2>Find standards you trust</h2>
        <p>
          Open a Reviewer to read their Policy, see public review context, and
          decide whether their judgment is relevant to your repository.
        </p>
      </article>
      <article>
        <p class="section-kicker">NEXT ACTION</p>
        <h2>Request review, not a Star</h2>
        <p>
          A Review Request asks for evaluation. PASS may result in that
          Reviewer's real GitHub Account starring the target repository.
        </p>
        <a class="inline-action" href={`${import.meta.env.BASE_URL}join/`}>
          Become a Reviewer →
        </a>
      </article>
    </section>
    {isLocalSnapshot && (
      <aside class="local-preview-note" role="status">
        <strong>Local preview: recorded Network Scan snapshot.</strong>
        <p>
          This preview shows the validated scan dated above. For a newer scan,
          provide its complete output through <code>SHOAL_PROJECTION_FILE</code>
          .
        </p>
      </aside>
    )}
    <ReviewerDirectory reviewers={projection.reviewers} client:load />
    <p class="directory-footnote">
      The Network Root and qualifying direct forks share this flat directory.
      Joined dates are repository creation dates, not setup completion dates.
      Search does not query GitHub live.
    </p>
  </main>
</BaseLayout>
