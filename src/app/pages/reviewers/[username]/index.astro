---
import type { GetStaticPaths } from "astro";
import type { ReviewerEntry } from "~app/network/services/network_projection";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { derivedMetrics } from "~app/guide/services/directory";
import { policyContent } from "~app/guide/services/policy_content";
import { publicProfile } from "~app/guide/services/profile_content";
import { publishedProjection } from "~app/guide/services/projection_source";
import ReviewPolicy from "~app/guide/components/ReviewPolicy";

export const getStaticPaths = (async () => {
  const projection = await publishedProjection();

  return projection.reviewers.map((reviewer) => ({
    params: { username: reviewer.username },
    props: { reviewer, generatedAt: projection.generatedAt },
  }));
}) satisfies GetStaticPaths;

const { reviewer, generatedAt } = Astro.props as {
  reviewer: ReviewerEntry;
  generatedAt: string;
};
const isLocalSnapshot =
  import.meta.env.DEV && !process.env.SHOAL_PROJECTION_FILE;
const selected = reviewer.summary;
const skipPublicContent = process.env.SHOAL_PUBLIC_CONTENT_FETCH === "skip";
const [policyMarkdown, profile] = skipPublicContent
  ? [null, null]
  : await Promise.all([
    policyContent(reviewer.repository, reviewer.policyUrl),
    publicProfile(reviewer.username),
  ]);
const metrics =
  selected.status === "unavailable" ? null : selected.summary.metrics;
const derived = metrics ? derivedMetrics(metrics) : null;
const title = `${reviewer.username} — Shoal Reviewer`;
const description = `Review Policy, public review metrics and Summary provenance for ${reviewer.username} on Shoal.`;
const requestUrl = `${reviewer.repositoryUrl}/issues/new/choose`;
const percent = (value: number | null) =>
  value === null ? "Not computable" : `${(value * 100).toFixed(1)}%`;
---

<BaseLayout title={title} description={description}>
  <main class="wrap reviewer-detail">
    {isLocalSnapshot && (
      <p role="status">
        Local preview of a validated scan from {generatedAt}. Check the current
        published directory for newer data.
      </p>
    )}
    <a href={`${import.meta.env.BASE_URL}reviewers/`}>← Reviewer Directory</a>
    <header class="detail-header">
      <img src={reviewer.avatarUrl} alt="" width="100" height="100" />
      <div>
        <p class="section-kicker">REVIEWER NODE</p>
        <h1>{reviewer.username}</h1>
        <p>
          Reviewer Node identity: Repository ID{" "}
          <code>{reviewer.repositoryId}</code>
        </p>
        <p>
          Joined (repository created):{" "}
          <time datetime={reviewer.joinedAt}>{reviewer.joinedAt}</time>
        </p>
      </div>
    </header>
    <section
      class="detail-panel reviewer-orientation"
      aria-labelledby="reviewer-meaning-title"
    >
      <div>
        <p class="section-kicker">WHAT THIS PAGE MEANS</p>
        <h2 id="reviewer-meaning-title">
          {reviewer.username} publishes their own review standard
        </h2>
        <p>
          Shoal is a public review network where repository owners request
          evaluation from independent Reviewers. A passing review may back{" "}
          {reviewer.username}'s real GitHub Star with public evidence.
        </p>
        <p>
          This page shows the Review Policy and public Shoal context for a
          person-controlled Reviewer Node. A Review Request asks{" "}
          {reviewer.username} to evaluate a repository against that Policy; it
          does not ask Shoal to grant a Star.
        </p>
      </div>
      <div class="orientation-actions" aria-label="Reviewer actions">
        <a class="button primary" href={requestUrl}>
          Request review ↗
        </a>
        <a class="button secondary" href="#policy-title">
          Read Review Policy ↓
        </a>
      </div>
      <ul class="meaning-list">
        <li>The Review Policy is owned by this Reviewer.</li>
        <li>PASS may result in this Reviewer's real GitHub Account starring the target repository.</li>
        <li>Shoal does not centrally approve, rank, or score this Reviewer.</li>
      </ul>
    </section>
    <section class="detail-panel profile-panel" aria-labelledby="profile-title">
      <div>
        <p class="section-kicker">PUBLIC GITHUB PROFILE</p>
        <h2 id="profile-title">{profile?.name || reviewer.username}</h2>
        {profile?.bio && <p>{profile.bio}</p>}
        {profile && (
          <p class="profile-meta">
            {profile.location && <span>⌖ {profile.location}</span>}
            <span>{profile.followers} GitHub followers</span>
          </p>
        )}
      </div>
      <a href={reviewer.profileUrl}>View GitHub profile ↗</a>
    </section>
    <section class="detail-panel" aria-labelledby="policy-title">
      <h2 id="policy-title">Review Policy</h2>
      <p class="snapshot-note">
        This is the Reviewer's own README.md Review Policy from the Reviewer
        Node commit captured by this projection.
      </p>
      {policyMarkdown ? (
        <ReviewPolicy
          markdown={policyMarkdown}
          policyUrl={reviewer.policyUrl}
        />
      ) : (
        <p>This snapshot has no README.md to display.</p>
      )}
      <p>
        <a href={reviewer.policyUrl}>View this README.md on GitHub ↗</a>
      </p>
      <p>
        <a href={reviewer.repositoryUrl}>
          Reviewer Node: {reviewer.repository} ↗
        </a>
      </p>
      <p>
        <a href={requestUrl}>
          Open this Reviewer's canonical Review Request surface ↗
        </a>
      </p>
      <p>
        <a href={reviewer.profileUrl}>GitHub profile ↗</a>
      </p>
    </section>
    <section class="detail-panel" aria-labelledby="summary-title">
      <h2 id="summary-title">Reviewer Summary</h2>
      <p class={`summary-state state-${selected.status}`}>
        {selected.status === "unavailable"
          ? "No Summary metrics"
          : `${selected.status} summary`}
      </p>
      {selected.status === "current" && (
        <p>
          The latest completed qualifying Summary Attempt was accepted. These
          metrics describe the currently selected public snapshot for this
          Reviewer.
        </p>
      )}
      {selected.status === "fallback" && (
        <p>
          The latest completed qualifying Summary Attempt was rejected. These
          metrics come from a prior accepted snapshot and must be read as stale
          fallback facts, not current Reviewer facts.
        </p>
      )}
      {selected.status === "unavailable" && (
        <p>
          This Reviewer is eligible to receive Review Requests. No accepted
          Summary snapshot is selected for this publication, so there are no
          metrics to show here. This does not affect Directory membership.
        </p>
      )}
      {metrics && derived && (
        <>
          <dl class="metric-grid">
            <div>
              <dt>Review-backed Stars</dt>
              <dd>{metrics.reviewBackedStarCount}</dd>
            </div>
            <div>
              <dt>Valid Review Request Issues</dt>
              <dd>{metrics.validReviewRequestIssueCount}</dd>
            </div>
            <div>
              <dt>Re-review Request Issues</dt>
              <dd>{metrics.reReviewRequestIssueCount}</dd>
            </div>
            <div>
              <dt>Invalid formal Review / Re-review result comments</dt>
              <dd>{metrics.invalidReviewCommentCount}</dd>
            </div>
          </dl>
          <p>
            Derived from this accepted snapshot: initial requests{" "}
            {derived.initialReviewRequestCount}; currently not endorsed{" "}
            {derived.currentlyNotEndorsedCount}; current endorsement share{" "}
            {percent(derived.currentEndorsementShare)}; re-review request share{" "}
            {percent(derived.reReviewRequestShare)}; re-review request intensity{" "}
            {percent(derived.reReviewRequestIntensity)}.
          </p>
        </>
      )}
      {selected.status !== "unavailable" && (
        <div class="provenance">
          <h3>Selected accepted Attempt</h3>
          <p>
            Repository ID {reviewer.repositoryId} · run {selected.source.runId}{" "}
            · attempt {selected.source.runAttempt}
          </p>
          <p>
            Started{" "}
            <time datetime={selected.source.runStartedAt}>
              {selected.source.runStartedAt}
            </time>{" "}
            · workflow commit <code>{selected.source.workflowCommit}</code>
          </p>
          <p>
            Workflow digest <code>{selected.source.workflowDigest}</code> ·
            pinned Action commit <code>{selected.source.actionCommit}</code>
          </p>
          <p>
            Public exact-byte transport digest{" "}
            <code>{selected.source.summaryDigest}</code>
          </p>
          <p>
            <a href={selected.source.transportUrl}>
              Selected Attempt public Summary transport ↗
            </a>{" "}
            · <a href={selected.source.runUrl}>Workflow run ↗</a>
          </p>
          <p>
            The public transport is a retrieval surface, not an independent
            trust anchor. The Network Aggregator accepted this Attempt upstream.
          </p>
        </div>
      )}
    </section>
    <p class="snapshot-note">
      Projection generated: <time datetime={generatedAt}>{generatedAt}</time>.
      GitHub is the source of truth; this website renders a derived snapshot.
    </p>
  </main>
</BaseLayout>
