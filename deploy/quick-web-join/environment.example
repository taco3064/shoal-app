# Public GitHub Actions variables used to generate production Wrangler config.
# GitHub reserves the GITHUB_ prefix for repository variables, so deploy inputs
# use SHOAL_GITHUB_* and map to Worker runtime GITHUB_APP_* vars during deploy.
SHOAL_GITHUB_APP_SLUG=
SHOAL_GITHUB_APP_ID=
SHOAL_GITHUB_APP_CLIENT_ID=
JOIN_SERVICE_ORIGIN=https://shoal-quick-web-join.YOUR-SUBDOMAIN.workers.dev
JOIN_WEBSITE_RETURN_URL=https://taco3064.github.io/shoal-app/join/
PUBLIC_SHOAL_JOIN_SERVICE_URL=https://shoal-quick-web-join.YOUR-SUBDOMAIN.workers.dev

# GitHub Actions deployment secrets. Never commit or log real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required Cloudflare Workers Secrets (wrangler secret put NAME).
# Never copy these into GitHub Actions deployment variables or repo files.
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
