{
  "name": "shoal-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The platform application and protocol source for the Shoal review network.",
  "repository": "https://github.com/taco3064/shoal-app",
  "homepage": "https://taco3064.github.io/shoal-app/",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:action": "tsc -p tsconfig.action.json",
    "package:action": "node scripts/package-action.mjs",
    "scan:network": "tsx src/network/index.ts",
    "validate:action-package": "node scripts/validate-action-package.mjs && node scripts/validate-evidence.mjs && node scripts/validate-canonical-compatibility.mjs && node scripts/validate-hosted-compatibility.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:workload": "node scripts/validate-workload.mjs",
    "preview": "astro preview",
    "lint": "eslint src --ext .astro --no-error-on-unmatched-pattern",
    "typecheck": "astro check && tsc --noEmit",
    "blueprint:validate": "blueprint doctor && blueprint inspect --baseline",
    "prepare": "husky",
    "serve:join": "wrangler dev",
    "build:join": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy:join": "wrangler deploy",
    "validate:seo-cases": "node scripts/validate-seo-cases.mjs",
    "validate:seo-http": "node scripts/validate-seo-http.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,astro}": "eslint --fix"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@kekkai/blueprint": "^4.1.0",
    "astro": "^7.3.4",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.0.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "parse5": "8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "wrangler": "^4.146.0"
  }
}
