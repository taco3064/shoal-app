{
  "name": "shoal-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The platform application and protocol source for the Shoal review network.",
  "repository": "https://github.com/taco3064/shoal-app",
  "homepage": "https://taco3064.github.io/shoal-app/",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:action": "tsc -p tsconfig.action.json",
    "package:action": "node scripts/package-action.mjs",
    "scan:network": "tsx src/network/index.ts",
    "test:network": "node --import tsx --test src/network/**/*.test.ts",
    "test:action": "node --import tsx --test src/action/**/*.test.ts",
    "test:action-package": "node scripts/test-action-package.mjs",
    "test:directory": "node --import tsx --test src/guide/services/directory/index.test.ts src/guide/services/directory_view/index.test.ts src/guide/services/policy_content/index.test.ts src/guide/services/profile_content/index.test.ts src/guide/components/ReviewPolicy/index.test.tsx",
    "test:seo": "node scripts/validate-seo.mjs",
    "preview": "astro preview",
    "lint": "eslint src --ext .astro --no-error-on-unmatched-pattern",
    "typecheck": "astro check && tsc --noEmit",
    "blueprint:validate": "blueprint doctor && blueprint inspect --baseline",
    "prepare": "husky",
    "test:join": "node --import tsx --test src/join/services/github_join/*.test.ts src/join/services/station_join/index.test.ts src/join/services/station_join/inspection.test.ts src/join/services/station_join/execute_step.test.ts src/join/services/join_client/*.test.ts src/join/services/join_server/config.test.ts src/join/components/**/*.test.tsx",
    "serve:join": "wrangler dev",
    "test:join:browser": "playwright test --config tests/quick-join-browser.config.mjs",
    "build:join": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy:join": "wrangler deploy",
    "test:join:worker": "npm run build:join && node --import tsx --test src/join/services/join_server/index.test.ts src/join/services/station_join/station_join.test.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,astro}": "eslint --fix"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@kekkai/blueprint": "^4.1.0",
    "astro": "^7.3.4",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.0.0",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "miniflare": "^5.20261001.0-alpha",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "wrangler": "^4.146.0"
  }
}
