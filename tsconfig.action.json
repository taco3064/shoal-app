{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist/action",
    "rootDir": ".",
    "noEmit": false
  },
  "include": ["protocol/review-v1.json", "src/action/**/*", "src/protocol/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
